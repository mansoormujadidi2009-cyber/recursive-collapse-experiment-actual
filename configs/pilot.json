{
  "decoder_model_name": "distilgpt2",
  "synth_generator_name": "distilgpt2",
  "encdec_model_name": "google/flan-t5-small",

  "ratios": [0.0, 0.5, 1.0],
  "seeds": [13, 42],

  "n_human_train_docs": 800,
  "n_human_eval_docs": 200,
  "max_synth_samples": 800,

  "block_size": 128,

  "epochs": 1,
  "lr_decoder": 0.0002,
  "lr_encdec": 0.0002,
  "batch_size": 4,
  "grad_accum": 2,
  "max_steps": 200,

  "lstm_embed": 256,
  "lstm_hidden": 256,
  "lstm_epochs": 1,
  "lstm_lr": 0.001,

  "gen_samples": 60,
  "prompt_chars": 160,
  "gen_max_new_tokens": 60,

  "nextseg_k": 4,

  "output_dir_results": "results",
  "output_dir_artifacts": "dataset_artifacts"
}
